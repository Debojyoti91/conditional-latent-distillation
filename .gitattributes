*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.npz binary
*.pt binary
*.pkl binary
*.png binary
*.pdf binary

# Preserve research/provenance bytes: input validation checks their SHA256 hashes.
artifacts/** -text
